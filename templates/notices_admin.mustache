}}
{{#groups}}
<div class="block-notices-group block-notices-group-{{groupcssclasssuffix}}" data-notice-count="{{count}}">
<h3>{{description}}</h3>
{{#count}}<div class="block-notices-count mb-2">{{count}} notice(s)</div>{{/count}}
{{^notices}}
<div class="block-notices-count">No notices</div>
{{/notices}}
<ul class="list-group pb-3">
    {{#notices}}
    <li class="list-group-item visibility-{{visible}} block-notices-item {{#hasimage}}item__has_image{{/hasimage}}" data-notice-id="{{id}}" data-notice-title="{{title}}">
        <span class="badge badge-light badge-sortorder sr-only">{{sortorder}}</span>

        <div class="block-notices-primary d-flex align-items-center">
            <div class="block-notices-status d-flex align-items-center">
                <span class="badge badge-{{css}} noticegroup">{{description}}</span>
                {{#staffonly}}<span class="badge badge-info staffonly">{{#str}} staffonly, block_notices {{/str}}</span>{{/staffonly}}
                {{#isexclusive_important}}<span class="badge badge-danger exclusive">{{#str}} exclusive_important, block_notices {{/str}}</span>{{/isexclusive_important}}
                {{#isexclusive_information}}<span class="badge badge-primary exclusive">{{#str}} exclusive_information, block_notices {{/str}}</span>{{/isexclusive_information}}

                {{#canshow}}<a class="block-notices-action" role="button" href="manage.php?sesskey={{sesskey}}&courseid={{courseid}}&action=show&id={{id}}" data-notice-action="show" title="{{#str}} show, core {{/str}}" aria-label="{{#str}} show, core {{/str}}">{{#pix}} t/hide, core, {{#str}} show, core {{/str}} {{/pix}}</a>{{/canshow}}
                {{#canhide}}<a class="block-notices-action" role="button" href="manage.php?sesskey={{sesskey}}&courseid={{courseid}}&action=hide&id={{id}}" data-notice-action="hide" title="{{#str}} hide, core {{/str}}" aria-label="{{#str}} hide, core {{/str}}">{{#pix}} t/show, core, {{#str}} hide, core {{/str}} {{/pix}}</a>{{/canhide}}
            </div>

            <div class="block-notices-actions-secondary d-flex align-items-center">
                {{#canmoveup}}<a role="button" href="manage.php?sesskey={{sesskey}}&courseid={{courseid}}&action=moveup&id={{id}}" data-notice-action="moveup" title="{{#str}} moveup, core {{/str}}" aria-label="{{#str}} moveup, core {{/str}}">{{#pix}} t/up, core, {{#str}} moveup, core {{/str}} {{/pix}}</a>{{/canmoveup}}
                {{#canmovedown}}<a role="button" href="manage.php?sesskey={{sesskey}}&courseid={{courseid}}&action=movedown&id={{id}}" data-notice-action="movedown" title="{{#str}} movedown, core {{/str}}" aria-label="{{#str}} movedown, core {{/str}}">{{#pix}} t/down, core, {{#str}} movedown, core {{/str}} {{/pix}}</a>{{/canmovedown}}

                {{#cansetexclusive_important}}<a role="button" href="manage.php?sesskey={{sesskey}}&courseid={{courseid}}&action=setexclusive&exclusive=1&id={{id}}" data-notice-action="setexclusive-important" title="{{#str}} setexclusiveimportant, block_notices {{/str}}" aria-label="{{#str}} setexclusiveimportant, block_notices {{/str}}">{{#pix}} i/notifications, core, {{#str}} setexclusiveimportant, block_notices {{/str}} {{/pix}}</a>{{/cansetexclusive_important}}
                {{#cansetexclusive_information}}<a role="button" href="manage.php?sesskey={{sesskey}}&courseid={{courseid}}&action=setexclusive&exclusive=2&id={{id}}" data-notice-action="setexclusive-information" title="{{#str}} setexclusiveinformation, block_notices {{/str}}" aria-label="{{#str}} setexclusiveinformation, block_notices {{/str}}">{{#pix}} i/circleinfo, core, {{#str}} setexclusiveinformation, block_notices {{/str}} {{/pix}}</a>{{/cansetexclusive_information}}
                {{#canclearexclusive}}<a role="button" href="manage.php?sesskey={{sesskey}}&courseid={{courseid}}&action=setexclusive&exclusive=0&id={{id}}" data-notice-action="clearexclusive" title="{{#str}} clearexclusive, block_notices {{/str}}" aria-label="{{#str}} clearexclusive, block_notices {{/str}}">{{#pix}} i/info, core, {{#str}} clearexclusive, block_notices {{/str}} {{/pix}}</a>{{/canclearexclusive}}

                {{#canpromote}}<a role="button" href="manage.php?sesskey={{sesskey}}&courseid={{courseid}}&action=promote&id={{id}}" data-notice-action="promote" title="{{#str}} promotenotice, block_notices {{/str}}" aria-label="{{#str}} promotenotice, block_notices {{/str}}">{{#pix}} i/marked, core, {{#str}} promotenotice, block_notices {{/str}} {{/pix}}</a>{{/canpromote}}

                <a role="button" href="#" data-action="notice-edit" data-noticeid="{{id}}" data-notice-action="edit" title="{{#str}} edit, core {{/str}}" aria-label="{{#str}} edit, core {{/str}}">{{#pix}} t/edit, core, {{#str}} edit, core {{/str}} {{/pix}}</a>
                {{#candelete}}<a role="button" href="manage.php?sesskey={{sesskey}}&courseid={{courseid}}&action=delete&id={{id}}" data-notice-action="delete" title="{{#str}} delete, core {{/str}}" aria-label="{{#str}} delete, core {{/str}}">{{#pix}} t/delete, core, {{#str}} delete, core {{/str}} {{/pix}}</a>{{/candelete}}
            </div>
        </div>

        <div class="block-notices-title-row d-flex w-100 justify-content-start align-items-center">
            <h5 class="mb-0">{{title}}</h5>
            <small class="item__info" data-block-notices-updatedescription data-timecreated="{{timecreated}}" data-timemodified="{{timemodified}}"><i class="fa-regular fa-hourglass" aria-hidden="true"></i></small>
            {{#ismodified}}
            <small class="item__info block-notices-readcount" data-readcount="{{readcount}}" data-readcountcurrent="{{readcountcurrent}}" title="{{#str}} nreads_help, block_notices {{/str}}">{{#str}} nreads_currenttotal, block_notices, { "current": "{{readcountcurrent}}", "total": "{{readcount}}" } {{/str}}</small>
            {{/ismodified}}
            {{^ismodified}}
            <small class="item__info block-notices-readcount" data-readcount="{{readcount}}">{{#str}} nreads, block_notices, {{readcount}} {{/str}}</small>
            {{/ismodified}}
        </div>

        <div class="block-notices-content-row d-flex">
            <div class="block-notices-content mb-1">{{{content}}}</div>
            {{#hasimage}}
            <div class="img" role="presentation" style="background-image:url('{{imageurl}}');"></div>
            {{/hasimage}}
        </div>

        <div class="block-notices-details">
            <small>{{#str}} moreinformationurl, block_notices {{/str}}: <a href="{{moreinformationurl}}" target="_blank">{{moreinformationurl}}</a></small>
            <small>{{#str}} owner, block_notices {{/str}}: <a title="Click to email" href="mailto:{{owneremail}}">{{owner}}</a></small>
            <small>{{#str}} createdby, block_notices {{/str}}: <a href="{{createdbylink}}" target="_blank">{{createdby}}</a></small>
            <small>{{#str}} modifiedby, block_notices {{/str}}: <a href="{{modifiedbylink}}" target="_blank">{{modifiedby}}</a></small>
        </div>
    </li>
    {{/notices}}
</ul>
</div>
{{/groups}}
<hr>

{{#canmanageall}}
<div>
<a role="button" href="#" data-action="notice-add">
{{#pix}} t/preferences, core, {{#str}} addnotice, block_notices {{/str}} {{/pix}}{{#str}} addnotice, block_notices {{/str}}
</a>
</div>
{{/canmanageall}}
